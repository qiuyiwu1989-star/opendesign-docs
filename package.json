{
  "name": "opendesign-docs",
  "version": "0.1.0-alpha.1",
  "description": "A local-first visual HTML document editor and presentation workspace.",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:domain": "tsc --noEmit && vite build --base=/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "tsx scripts/audit.ts"
  },
  "dependencies": {
    "parse5": "7.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
